# 蜀道安全助手 backend 环境变量模板
# 用法：cp .env.example .env 后按本机实际修改。约定：每文件夹一份 .env，从 shudao/backend 目录运行。

# ===== MySQL（对齐 DATABASE.md §9，库名 shudao，utf8mb4）=====
# 密码含特殊字符需 URL 编码（如 @ 写成 %40）
DATABASE_URL=mysql+pymysql://root:你的MySQL密码@127.0.0.1:3306/shudao?charset=utf8mb4

# ===== Redis（E04 考试会话：切屏计数/草稿/倒计时）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT（B01/B02）=====
JWT_SECRET=dev-only-change-me-please-random-64-char
JWT_EXPIRE_MINUTES=120

# ===== 初始化账号（Phase0 init_db.py 写入 role + admin）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ===== E02 出题（Phase2 启用，键名对齐 8_10/.env：BASE_URL/API_KEY/MODEL_NAME）=====
BASE_URL=https://api.deepseek.com
API_KEY=sk-你的key
MODEL_NAME=deepseek-chat
LAW_JSON_DIR=../crawler_output
GEN_MIN_COUNT=5
