 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某建筑工地塔式起重机在吊装作业过程中发生倾覆倒塌，砸中施工区域，造成人员伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "塔吊超载吊装，力矩限制器等安全装置失效未及时修复。"
    },
    {
     "no": "第三条",
     "content": "塔吊基础或附着装置存在缺陷，未按规定检查验收。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "起重机械安全管理不到位，检验检测流于形式。"
    },
    {
     "no": "第五条",
     "content": "作业人员违章指挥、违章操作，信号指挥不规范。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格落实起重机械检验检测和使用登记制度，确保安全装置灵敏可靠。"
    },
    {
     "no": "第八条",
     "content": "加强塔吊司机、司索信号工培训考核，严禁超载违章作业。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
