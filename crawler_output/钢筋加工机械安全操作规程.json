 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "作业前检查切断机、弯曲机、调直机等设备防护装置与电气线路完好，空载试运行。"
    },
    {
     "no": "第四条",
     "content": "作业区清理干净，无关人员撤离危险区域。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "切断钢筋时握紧料头，送料均匀，禁止手伸入刀口区域，短料使用夹具。"
    },
    {
     "no": "第六条",
     "content": "弯曲机作业时钢筋放置到位后方可启动，操作者站在设备侧面。"
    },
    {
     "no": "第七条",
     "content": "调直机送料时人员站在料架侧面，禁止正对料头。"
    },
    {
     "no": "第八条",
     "content": "设备运转中禁止清理、检修，作业完毕切断电源。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生夹伤、切断等伤害立即停机急救并送医。"
    },
    {
     "no": "第十条",
     "content": "设备故障停机断电后由专业人员检修。"
    }
   ]
  }
 ]
}