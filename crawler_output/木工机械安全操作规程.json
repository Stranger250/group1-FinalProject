 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "作业前检查圆盘锯、平刨等木工机械防护罩、锯片、刨刀完好，试运转正常。"
    },
    {
     "no": "第四条",
     "content": "穿戴紧身工作服，禁止戴手套操作旋转类木工机械。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "操作圆盘锯时物料推送平稳，手与锯片保持安全距离，禁止倒锯、反推。"
    },
    {
     "no": "第六条",
     "content": "平刨作业手指不得越过刨口，短料使用推板推送。"
    },
    {
     "no": "第七条",
     "content": "锯片、刨刀变钝及时更换，机械运转中禁止清理、调整、润滑。"
    },
    {
     "no": "第八条",
     "content": "木屑、刨花及时清理，作业区禁止吸烟和明火。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生机械伤害立即停机，实施止血包扎急救并送医。"
    },
    {
     "no": "第十条",
     "content": "机械卡料、异响立即停机断电检查处理。"
    }
   ]
  }
 ]
}