 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "电梯维保人员持证上岗，作业前设置检修警示标志，确认轿厢、井道无人员。"
    },
    {
     "no": "第四条",
     "content": "检查安全钳、限速器、门锁等安全装置完好。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "检修作业时置于检修状态，轿厢内、井道内作业设置双重保护。"
    },
    {
     "no": "第六条",
     "content": "进入井道、底坑作业时，断开相应电源开关并挂牌上锁。"
    },
    {
     "no": "第七条",
     "content": "盘车移动轿厢时先切断电源，两人配合，防止轿厢意外移动。"
    },
    {
     "no": "第八条",
     "content": "作业完毕清理现场，恢复电梯正常运行并试运行确认。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生困人故障，维保人员按救援程序手动盘车放人，禁止非专业人员救援。"
    },
    {
     "no": "第十条",
     "content": "发现安全隐患立即停止电梯运行并报告。"
    }
   ]
  }
 ]
}