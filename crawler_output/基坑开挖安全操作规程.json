 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "基坑开挖前编制专项方案，进行安全技术交底，查明地下管线、电缆等设施。"
    },
    {
     "no": "第四条",
     "content": "按方案放坡或设置支护，基坑周边设置防护栏杆和警示标志。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "机械开挖时人员与机械保持安全距离，严禁在机械回转半径内作业。"
    },
    {
     "no": "第六条",
     "content": "人工开挖保持安全距离，严禁在坑壁下掏挖。"
    },
    {
     "no": "第七条",
     "content": "基坑周边荷载不得超过设计允许值，堆载距坑边不小于1米。"
    },
    {
     "no": "第八条",
     "content": "坑内作业人员按规定通道上下，禁止攀爬支护结构。"
    },
    {
     "no": "第九条",
     "content": "雨季施工做好排水措施，监测坑壁位移、渗水情况。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第十条",
     "content": "发现坑壁裂缝、坍塌征兆立即撤出人员并报告。"
    },
    {
     "no": "第11条",
     "content": "发生坍塌事故，立即报警，在确保安全的前提下组织救援。"
    }
   ]
  }
 ]
}