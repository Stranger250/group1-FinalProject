 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "运行人员检查水泵、电机、阀门、仪表完好，电气接线与接地可靠。"
    },
    {
     "no": "第四条",
     "content": "确认集水池液位正常，进出口阀门状态正确。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "启动前盘车检查，确认无卡阻后启动，监视电流、压力、温度参数正常。"
    },
    {
     "no": "第六条",
     "content": "运行中定期巡检，检查轴承温度、密封泄漏、异常振动噪声。"
    },
    {
     "no": "第七条",
     "content": "严禁湿手操作电气设备，检修作业断电挂牌。"
    },
    {
     "no": "第八条",
     "content": "停机按规程操作，关闭阀门，做好运行记录。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发现异常立即停机检查，必要时切换备用泵。"
    },
    {
     "no": "第十条",
     "content": "发生漏电、火灾立即断电处置并报警。"
    }
   ]
  }
 ]
}