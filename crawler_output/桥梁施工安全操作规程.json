 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "桥梁高处、水上作业前检查作业平台、防护设施、救生设备完好。"
    },
    {
     "no": "第四条",
     "content": "作业人员进行安全技术交底，特种作业人员持证上岗。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "挂篮、支架等大型临时结构按方案安装，使用前进行荷载试验和验收。"
    },
    {
     "no": "第六条",
     "content": "水上作业穿救生衣，临边设置防护栏杆和安全网。"
    },
    {
     "no": "第七条",
     "content": "预应力张拉作业时，张拉端设置防护挡板，严禁站人。"
    },
    {
     "no": "第八条",
     "content": "架梁作业统一指挥，吊装区域设置警戒，禁止人员滞留。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发现支架、挂篮变形立即停止作业，撤离人员检查处理。"
    },
    {
     "no": "第十条",
     "content": "发生坠落、落水事故立即组织打捞救援并报警。"
    }
   ]
  }
 ]
}