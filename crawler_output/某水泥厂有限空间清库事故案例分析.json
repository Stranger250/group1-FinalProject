 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某水泥厂作业人员进入水泥储存库清理结块物料时，物料突然坍塌将其掩埋致死。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "库内物料悬挂结块，清理作业扰动导致物料整体塌落。"
    },
    {
     "no": "第三条",
     "content": "未采取防止物料坍塌的可靠措施（如设置安全平台、系挂安全绳）。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "清库作业未制定专项方案，审批流于形式。"
    },
    {
     "no": "第五条",
     "content": "作业人员未系挂安全绳，监护不到位。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "制定清库专项方案，作业人员系挂安全绳并设专人监护。"
    },
    {
     "no": "第八条",
     "content": "采用机械清库工艺，减少人员进入。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
