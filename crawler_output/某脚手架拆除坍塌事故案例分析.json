 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某工地拆除外脚手架时，作业人员同时拆除连墙件，架体失稳整体坍塌，造成人员伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "拆除顺序错误，连墙件提前拆除导致架体失稳。"
    },
    {
     "no": "第三条",
     "content": "未设置警戒区，人员未及时撤离。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "拆除作业无专项交底，违规上下同时作业。"
    },
    {
     "no": "第五条",
     "content": "现场安全监管缺失。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格按拆除方案自上而下逐层拆除，连墙件随层拆除。"
    },
    {
     "no": "第八条",
     "content": "设置警戒区，加强拆除作业全程监管。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
