   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某建筑工地工人宿舍使用违规电器引发火灾，火势蔓延造成人员伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "宿舍违规使用大功率电器，电气线路过载短路起火。"
    },
    {
     "no": "第三条",
     "content": "宿舍使用易燃夹芯板搭建，火势蔓延迅速。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "生活区用电管理失控，消防设施配备不足。"
    },
    {
     "no": "第五条",
     "content": "安全保卫和夜间巡查缺失。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "规范生活区用电管理，拆除易燃夹芯板房，配备灭火器材。"
    },
    {
     "no": "第八条",
     "content": "加强夜间巡查和消防演练。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
