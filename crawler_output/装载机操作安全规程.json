 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "操作人员持证上岗，作业前检查制动、转向、铲斗举升装置完好。"
    },
    {
     "no": "第四条",
     "content": "作业区地面平整坚实，确认周围无人后方可作业。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "铲装作业时铲斗平稳升降，禁止高速铲装和急转弯。"
    },
    {
     "no": "第六条",
     "content": "铲斗举升时下方严禁站人、通行，禁止铲斗载人。"
    },
    {
     "no": "第七条",
     "content": "行驶时铲斗降低至离地30厘米左右，视线良好，倒车时鸣笛观察。"
    },
    {
     "no": "第八条",
     "content": "坡道行驶保持低速，禁止空挡溜坡。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "制动失灵时立即采取紧急制动并鸣笛示警。"
    },
    {
     "no": "第十条",
     "content": "发生倾翻事故立即熄火，救助被困人员并报警。"
    }
   ]
  }
 ]
}