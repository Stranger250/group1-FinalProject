 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "操作人员持证上岗，作业前检查液压系统、铲斗、行走机构、灯光喇叭完好。"
    },
    {
     "no": "第四条",
     "content": "了解地下管线、电缆等埋设情况，确认作业范围安全。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "作业时机器平稳，铲斗回转范围内禁止站人，回转时注意观察周围。"
    },
    {
     "no": "第六条",
     "content": "挖掘作业保持与边坡、沟槽边缘的安全距离，防止塌方陷机。"
    },
    {
     "no": "第七条",
     "content": "装车作业时铲斗不得从驾驶室上方越过。"
    },
    {
     "no": "第八条",
     "content": "停机时将铲斗落地，发动机熄火，取走钥匙。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发现边坡开裂、异常渗水立即撤出机器并报告。"
    },
    {
     "no": "第十条",
     "content": "发生倾覆、挤压事故立即停机救援并报警。"
    }
   ]
  }
 ]
}