 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某建筑工地现浇混凝土模板支撑体系失稳坍塌，浇筑作业人员随架体坠落被埋，造成伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "模板支撑体系未按方案搭设，立杆间距过大、缺少水平杆和剪刀撑。"
    },
    {
     "no": "第三条",
     "content": "混凝土浇筑顺序不当，局部荷载集中超限。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "专项方案未论证审批，搭设未经验收即投入使用。"
    },
    {
     "no": "第五条",
     "content": "监理旁站缺失，浇筑过程无人监控架体变形。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "高大模板支撑体系专项方案必须论证审批，搭设完成验收合格后浇筑。"
    },
    {
     "no": "第八条",
     "content": "浇筑过程设专人监测架体，发现异常立即停止浇筑撤人。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
