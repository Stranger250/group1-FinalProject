 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "叉车司机持证上岗，作业前检查制动、转向、灯光、货叉、链条完好。"
    },
    {
     "no": "第四条",
     "content": "了解货物重量，确认在额定载荷范围内。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "叉取货物时货叉对准插入，货物重心居中，叉车起步、转弯减速鸣笛。"
    },
    {
     "no": "第六条",
     "content": "载货行驶时门架后倾，货叉离地200-300毫米，禁止货物超高遮挡视线。"
    },
    {
     "no": "第七条",
     "content": "禁止叉车载人、超载、高速行驶，禁止用货叉顶推、撞击其他物体。"
    },
    {
     "no": "第八条",
     "content": "在坡道行驶时货物朝向坡上，禁止坡道转弯和横穿。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "货物倾翻时立即制动，人员撤离危险区域。"
    },
    {
     "no": "第十条",
     "content": "发生碰撞伤人立即停车救助并报告。"
    }
   ]
  }
 ]
}