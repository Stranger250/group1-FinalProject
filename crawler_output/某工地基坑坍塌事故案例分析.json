 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某市政工程基坑开挖过程中，基坑边坡发生坍塌，将坑内作业人员掩埋，造成人员伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "基坑未按方案放坡或支护，边坡土体失稳坍塌。"
    },
    {
     "no": "第三条",
     "content": "基坑周边堆载超过设计允许值，加剧边坡失稳。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "施工方案编制审批不严，未按方案组织施工。"
    },
    {
     "no": "第五条",
     "content": "汛期降雨未及时排水，土体含水量增大导致强度降低。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格按照专项方案放坡支护，加强基坑监测，落实排水措施。"
    },
    {
     "no": "第八条",
     "content": "规范基坑周边堆载管理，建立雨天巡视制度。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
