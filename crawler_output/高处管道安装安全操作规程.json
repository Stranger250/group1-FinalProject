 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "高处管道安装作业前检查脚手架、吊装设备、工器具完好，办理高处作业审批。"
    },
    {
     "no": "第四条",
     "content": "作业人员系挂安全带，吊装作业设专人指挥。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "管道吊装捆绑牢固，起吊平稳，严禁吊物下站人。"
    },
    {
     "no": "第六条",
     "content": "管道对口、焊接作业站在稳固平台上，工具材料放置稳妥。"
    },
    {
     "no": "第七条",
     "content": "阀门、管件安装注意吊装平衡，防止坠落伤人。"
    },
    {
     "no": "第八条",
     "content": "试压作业设置警戒区，升压缓慢，严禁超压。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生坠落、砸伤立即急救送医。"
    },
    {
     "no": "第十条",
     "content": "试压泄漏立即泄压处理，禁止带压紧固。"
    }
   ]
  }
 ]
}