 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "摊铺机、压路机操作人员持证上岗，作业前检查设备与加热系统完好。"
    },
    {
     "no": "第四条",
     "content": "作业现场设置交通警示标志，作业人员穿戴反光背心等防护用品。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "沥青混合料温度较高，作业人员防止烫伤，禁止接触高温料车料斗。"
    },
    {
     "no": "第六条",
     "content": "摊铺机作业时两侧禁止站人，料车倒车时设专人指挥。"
    },
    {
     "no": "第七条",
     "content": "压路机作业保持安全距离，倒车鸣笛观察。"
    },
    {
     "no": "第八条",
     "content": "现场配备灭火器材，禁止在沥青加热区吸烟动火。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生烫伤立即用冷水冲洗降温并送医。"
    },
    {
     "no": "第十条",
     "content": "沥青起火用干粉、砂土扑救，禁止用水扑救热沥青火灾。"
    }
   ]
  }
 ]
}