 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某工厂维修电工在检修配电柜时，未执行停电挂牌制度，误合闸导致作业人员触电死亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "检修作业未断电、未验电、未挂接地线，违反停送电作业规程。"
    },
    {
     "no": "第三条",
     "content": "配电柜警示标识缺失，操作人员误操作合闸送电。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "检修作业许可制度执行不严，监护措施缺失。"
    },
    {
     "no": "第五条",
     "content": "电气安全管理混乱，线路私拉乱接现象突出。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格执行停电、验电、装设接地线、悬挂标示牌和装设遮栏的检修安全技术措施。"
    },
    {
     "no": "第八条",
     "content": "加强电气作业票管理，完善警示标识和上锁挂牌制度。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
