 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某高速公路养护作业区未按规范设置警示标志和缓冲设施，社会车辆闯入作业区，撞伤养护人员。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "作业区安全防护设施设置不规范，警示标志缺失或不足。"
    },
    {
     "no": "第三条",
     "content": "未安排专职交通引导人员。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "养护作业安全管理不到位，作业方案审查不严。"
    },
    {
     "no": "第五条",
     "content": "夜间或恶劣天气作业防护不足。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格按规范设置作业区交通标志、锥桶和缓冲设施。"
    },
    {
     "no": "第八条",
     "content": "加强作业人员安全培训，配备反光服，落实专人瞭望引导。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
