  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某建筑工地施工电梯（人货梯）运行中制动失效，轿厢坠落，造成人员伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "施工电梯制动器、防坠安全器失效，未及时发现维修。"
    },
    {
     "no": "第三条",
     "content": "超载运行，安全保护装置被短接。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "电梯日常检查维护不到位，检验检测走过场。"
    },
    {
     "no": "第五条",
     "content": "维保人员无证作业，违规短接安全回路。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格执行电梯日检、周检和定期检验制度，严禁短接安全装置。"
    },
    {
     "no": "第八条",
     "content": "加强维保人员资质管理和作业监督。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
