   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某热力管道检修作业中，蒸汽阀门误开启，高温蒸汽喷出烫伤检修人员。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "检修作业未隔离热源，阀门未关闭、未挂牌。"
    },
    {
     "no": "第三条",
     "content": "作业人员未穿戴隔热防护用品。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "作业许可和能量隔离制度执行不严。"
    },
    {
     "no": "第五条",
     "content": "现场协调沟通不畅。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格执行能量隔离（上锁挂牌）制度。"
    },
    {
     "no": "第八条",
     "content": "配备隔热防护用品，加强检修作业安全管理。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
