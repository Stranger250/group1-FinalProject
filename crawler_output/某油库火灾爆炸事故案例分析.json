   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某油库在进行油罐清洗作业时发生爆炸燃烧，造成人员伤亡和储罐损毁。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "油罐清洗前未彻底置换清洗，罐内油气浓度达到爆炸极限。"
    },
    {
     "no": "第三条",
     "content": "清洗作业使用非防爆工具产生火花，或静电放电引燃。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "动火及受限空间作业审批不严，气体检测缺失。"
    },
    {
     "no": "第五条",
     "content": "防静电措施不落实，作业人员穿着化纤服装。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格执行油罐清洗置换检测程序，检测合格后作业。"
    },
    {
     "no": "第八条",
     "content": "使用防爆工具，落实防静电措施，严格作业审批。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
