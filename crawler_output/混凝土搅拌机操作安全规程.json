 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "搅拌机安装平稳、固定可靠，防护罩齐全，检查电气线路与接地良好。"
    },
    {
     "no": "第四条",
     "content": "作业前空载试运转，确认搅拌筒旋转方向正确、无异常声响。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "运转中禁止将工具、手伸入搅拌筒内，禁止在筒口清理物料。"
    },
    {
     "no": "第六条",
     "content": "进料斗升起时下方禁止站人，料斗检修时插好安全销。"
    },
    {
     "no": "第七条",
     "content": "添加外加剂、观察搅拌情况时与筒口保持安全距离。"
    },
    {
     "no": "第八条",
     "content": "作业完毕清洗搅拌筒，切断电源，锁好配电箱。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生卷入伤害立即断电停机施救并拨打急救电话。"
    },
    {
     "no": "第十条",
     "content": "设备异响、漏电立即停机检查。"
    }
   ]
  }
 ]
}