 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "搬运前了解化学品性质，查阅安全技术说明书（SDS），穿戴相应防护用品。"
    },
    {
     "no": "第四条",
     "content": "检查包装完好、标识清晰，确认无泄漏。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "搬运轻拿轻放，禁止抛掷、撞击、拖拽，防止包装破损泄漏。"
    },
    {
     "no": "第六条",
     "content": "酸、碱等腐蚀品搬运佩戴防护眼镜和耐酸碱手套，严禁与氧化剂混运。"
    },
    {
     "no": "第七条",
     "content": "使用搬运机械时载荷不超限，通道畅通。"
    },
    {
     "no": "第八条",
     "content": "搬运完毕清理现场，按规定洗手更衣，禁止在作业区进食饮水。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生泄漏按SDS要求处置，设置警戒，禁止无关人员接近。"
    },
    {
     "no": "第十条",
     "content": "皮肤、眼睛接触化学品立即用大量清水冲洗并就医。"
    }
   ]
  }
 ]
}