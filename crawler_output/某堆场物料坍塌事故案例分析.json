 "chapters": [
  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某堆场砂石料堆放过高过陡，作业人员在料堆底部作业时物料坍塌将其掩埋。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "料堆堆放过高、边坡过陡，未按规范堆放。"
    },
    {
     "no": "第三条",
     "content": "作业人员在料堆底部危险区域作业。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "堆场安全管理缺失，未设置警示标志。"
    },
    {
     "no": "第五条",
     "content": "作业安排不合理。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "规范物料堆放高度和坡度，设置警戒区。"
    },
    {
     "no": "第八条",
     "content": "加强堆场安全巡查和作业管理。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
