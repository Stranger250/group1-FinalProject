 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "作业人员持证上岗，作业前检查焊割设备、气瓶、胶管完好，办理动火审批。"
    },
    {
     "no": "第四条",
     "content": "清理作业现场可燃物，配置灭火器材，必要时设置接火盆和防火布。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "高处焊割作业使用接火措施，防止火花溅落引燃下方可燃物。"
    },
    {
     "no": "第六条",
     "content": "在易燃易爆区域动火必须执行“动火分析合格后方可动火”要求。"
    },
    {
     "no": "第七条",
     "content": "焊接作业防止弧光、飞溅伤害，佩戴防护面罩。"
    },
    {
     "no": "第八条",
     "content": "作业完毕检查作业点及周边，确认无火种后撤离。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "火花引燃立即扑救并报警，组织人员疏散。"
    },
    {
     "no": "第十条",
     "content": "发生触电、烫伤按相应急救程序处置。"
    }
   ]
  }
 ]
}