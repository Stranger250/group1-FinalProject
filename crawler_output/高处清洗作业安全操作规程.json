   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "高处清洗作业前检查清洗设备、绳索、安全带完好，办理高处作业审批。"
    },
    {
     "no": "第四条",
     "content": "作业下方设置警戒区，防止落物伤人。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "作业人员系挂安全带，使用安全绳与生命线，严禁单独作业。"
    },
    {
     "no": "第六条",
     "content": "高压水枪操作时枪口严禁对人，检查管路接头牢固。"
    },
    {
     "no": "第七条",
     "content": "使用化学清洗剂时佩戴防护眼镜、手套，防止飞溅伤害。"
    },
    {
     "no": "第八条",
     "content": "恶劣天气停止室外高处清洗作业。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生坠落立即急救送医并报告。"
    },
    {
     "no": "第十条",
     "content": "清洗剂溅入眼睛立即用清水冲洗并就医。"
    }
   ]
  }
 ]
