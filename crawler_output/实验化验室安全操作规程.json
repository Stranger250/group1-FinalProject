   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "实验人员了解实验方案与危险特性，穿戴实验服、护目镜等防护用品。"
    },
    {
     "no": "第四条",
     "content": "检查实验设备、通风橱、气体报警装置完好。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "使用危险化学品严格执行领用登记，易燃易爆试剂远离火源，分类存放。"
    },
    {
     "no": "第六条",
     "content": "加热、蒸馏、反应实验在通风橱内进行，禁止无人看管运行。"
    },
    {
     "no": "第七条",
     "content": "正确使用高压气瓶，固定放置，远离热源。"
    },
    {
     "no": "第八条",
     "content": "实验废液分类收集，严禁倒入下水道，废弃物按规定处置。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生化学灼伤立即用大量清水冲洗并就医。"
    },
    {
     "no": "第十条",
     "content": "发生火灾、泄漏立即停止实验，按预案处置并报警。"
    }
   ]
  }
 ]
