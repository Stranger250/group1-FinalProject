 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "高处检查维修作业前办理审批手续，检查作业平台、梯具、安全绳完好。"
    },
    {
     "no": "第四条",
     "content": "作业人员穿戴安全带、安全帽，确认身体状态良好。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "使用梯子作业时梯脚防滑、梯顶固定，禁止垫高梯脚、攀爬梯子横档以上作业。"
    },
    {
     "no": "第六条",
     "content": "作业平台满铺、护栏齐全，工具装入工具袋，禁止上下抛掷。"
    },
    {
     "no": "第七条",
     "content": "作业过程中设专人监护，下方设置警戒区。"
    },
    {
     "no": "第八条",
     "content": "带电设备附近作业保持安全距离，必要时断电挂牌。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生坠落立即急救送医，保护现场。"
    },
    {
     "no": "第十条",
     "content": "发现平台、梯具异常立即停止作业撤离。"
    }
   ]
  }
 ]
}