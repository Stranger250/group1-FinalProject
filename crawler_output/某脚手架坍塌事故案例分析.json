  {
   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某工程外脚手架搭设未按方案施工，连墙件缺失，架体整体失稳坍塌，造成作业人员伤亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "脚手架立杆间距、步距超出方案要求，连墙件设置严重不足。"
    },
    {
     "no": "第三条",
     "content": "作业层超载堆放材料，架体受力超限。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "专项方案与现场实际不符，验收走过场。"
    },
    {
     "no": "第五条",
     "content": "监理单位未有效履行监理职责。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "依据事故调查结论，对相关责任单位和责任人依法依规追究责任。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "严格按方案搭设并组织验收，规范连墙件、剪刀撑设置。"
    },
    {
     "no": "第八条",
     "content": "加强架体使用荷载管理，定期检查维护。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
