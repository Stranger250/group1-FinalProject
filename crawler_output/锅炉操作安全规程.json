 "status": "现行有效",
 "chapters": [
  {
   "chapter": "第一章 适用范围",
   "articles": [
    {
     "no": "第一条",
     "content": "本规程适用于本企业相关作业活动的安全操作管理。"
    },
    {
     "no": "第二条",
     "content": "作业人员应当经培训考核合格后上岗，并严格遵守本规程。"
    }
   ]
  },
  {
   "chapter": "第二章 作业前准备",
   "articles": [
    {
     "no": "第三条",
     "content": "锅炉司炉工持证上岗，作业前检查水位计、压力表、安全阀、排污装置完好。"
    },
    {
     "no": "第四条",
     "content": "确认锅炉本体及附属设备无异常后方可点火启动。"
    }
   ]
  },
  {
   "chapter": "第三章 作业要求",
   "articles": [
    {
     "no": "第五条",
     "content": "严格按操作规程点火、升压、运行，控制水位、压力、温度在正常范围。"
    },
    {
     "no": "第六条",
     "content": "每班冲洗水位计、试验安全阀，定期排污。"
    },
    {
     "no": "第七条",
     "content": "锅炉运行中不得离开岗位，严密监视各项参数。"
    },
    {
     "no": "第八条",
     "content": "停炉按规程缓慢降温降压，做好保养。"
    }
   ]
  },
  {
   "chapter": "第四章 应急处置",
   "articles": [
    {
     "no": "第九条",
     "content": "发生缺水、满水、汽水共腾等异常，按规程紧急停炉处理。"
    },
    {
     "no": "第十条",
     "content": "发现爆炸危险征兆立即紧急停炉，疏散人员并报警。"
    }
   ]
  }
 ]
}