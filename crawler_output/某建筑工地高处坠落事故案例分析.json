   "chapter": "第一章 事故概况",
   "articles": [
    {
     "no": "第一条",
     "content": "某建筑工地一名作业人员在脚手架临边作业时，未系挂安全带，失足从高处坠落，经抢救无效死亡。"
    }
   ]
  },
  {
   "chapter": "第二章 直接原因",
   "articles": [
    {
     "no": "第二条",
     "content": "作业人员违反高处作业安全操作规程，未正确佩戴使用安全带，是事故的直接原因。"
    },
    {
     "no": "第三条",
     "content": "作业层临边防护栏杆缺失或设置不规范，未形成有效防护。"
    }
   ]
  },
  {
   "chapter": "第三章 间接原因",
   "articles": [
    {
     "no": "第四条",
     "content": "项目部安全教育培训流于形式，作业人员安全意识淡薄。"
    },
    {
     "no": "第五条",
     "content": "现场安全巡查不到位，未及时发现和纠正违章作业行为。"
    }
   ]
  },
  {
   "chapter": "第四章 责任追究",
   "articles": [
    {
     "no": "第六条",
     "content": "施工单位对事故负有管理责任，依据调查结论对项目负责人、安全管理人员及违章作业人员依法依规处理。"
    }
   ]
  },
  {
   "chapter": "第五章 整改措施",
   "articles": [
    {
     "no": "第七条",
     "content": "全面排查高处作业防护设施，落实安全带高挂低用要求，加强临边洞口防护。"
    },
    {
     "no": "第八条",
     "content": "强化高处作业安全技术交底和班前教育，实行作业票审批与现场旁站监督。"
    }
   ]
  },
  {
   "chapter": "第六章 警示教训",
   "articles": [
    {
     "no": "第九条",
     "content": "安全生产责任重于泰山，必须时刻绷紧安全这根弦，把安全责任落实到岗位、落实到人头。"
    }
   ]
  }
 ]
